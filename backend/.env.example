# Backend configuration template. Copy to `.env` and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Server
PORT=5000
# development | production  (production enforces the security checks in validateEnv.js)
NODE_ENV=development
# Comma-separated allowlist of browser origins permitted by CORS.
# Defaults to local dev origins. REQUIRED in production — the server refuses to
# start without a non-localhost entry, because an unset allowlist silently
# blocks the deployed frontend at the CORS preflight while still reporting
# healthy. Each entry must be an exact origin: scheme://host[:port], with no
# trailing slash, path or query (the Origin header is matched by strict string
# compare). Vercel preview deploys get a new hostname per deploy — list the
# production domain, not a preview URL.
#   e.g. ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to true to enable verbose per-request logging (secrets are still redacted).
# Leave unset/false otherwise. Never enable in production.
DEBUG_HTTP=false

# JWT signing secret — long random value, >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Xibo CMS API (OAuth client-credentials app)
XIBO_API_URL=https://your-xibo-host/api
XIBO_CLIENT_ID=
XIBO_CLIENT_SECRET=

# Xibo web service account — used for layout thumbnails and the web-login
# password check. Prefer a dedicated, least-privilege account; rotate regularly.
XIBO_WEB_USERNAME=
XIBO_WEB_PASSWORD=

# Do NOT set NODE_TLS_REJECT_UNAUTHORIZED=0 in production — it disables TLS
# certificate verification (MITM risk). Fix the Xibo certificate trust instead.
